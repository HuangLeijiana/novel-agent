# ============================================================
# Novel Agent — 智能网文写作助手
# ============================================================
# 复制此文件为 .env，填入你的 API Key 即可启动。
#
# 五套方案，选一套取消注释：
#   A. ModelScope 魔搭（免费，每日2000次）— 零成本试用
#   B. DeepSeek API（¥1/百万输出token，一部小说约¥5-10）
#   C. 阿里云百炼 DashScope（Qwen官方，¥4/百万输出token）
#   D. Anthropic Claude（$3/百万输入，$15/百万输出，质量最高）
#   E. 本地 Ollama（免费，需GPU）
#
# 高级玩法：设置 DEFAULT_PROVIDER + DEFAULT_MODEL 用于所有 Agent，
# 再设置 BUDGET_PROVIDER + BUDGET_MODEL 让检查类 Agent 走更便宜的模型。
# ============================================================


# ============================================================
# 方案 A：ModelScope 魔搭（免费）
# ============================================================
# 1. 注册 https://modelscope.cn → 获取 SDK Token
# 2. 取消下面三行注释，填入 token
OPENAI_API_KEY=ms-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
DEFAULT_PROVIDER=modelscope
DEFAULT_MODEL=Qwen/Qwen3-235B-A22B
# BUDGET_MODEL=Qwen/Qwen3-8B  # 可选：检查类Agent用更便宜的模型


# ============================================================
# 方案 B：DeepSeek API（推荐，性价比最高）
# ============================================================
# 1. 注册 https://platform.deepseek.com
# 2. 取消下面四行注释，填入 key
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# DEFAULT_PROVIDER=openai
# DEFAULT_MODEL=deepseek-chat


# ============================================================
# 方案 C：阿里云百炼 DashScope（Qwen 官方）
# ============================================================
# 1. 注册 https://dashscope.aliyun.com → 获取 API Key
# 2. 取消下面四行注释，填入 key
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEFAULT_PROVIDER=dashscope
# DEFAULT_MODEL=qwen-max
# BUDGET_MODEL=qwen-turbo


# ============================================================
# 方案 D：Anthropic Claude（质量最高，需海外支付）
# ============================================================
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# DEFAULT_PROVIDER=anthropic
# DEFAULT_MODEL=claude-sonnet-4-20250514
# BUDGET_MODEL=claude-haiku-4-5-20251001


# ============================================================
# 方案 D2：OpenAI
# ============================================================
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEFAULT_PROVIDER=openai
# DEFAULT_MODEL=gpt-4o
# BUDGET_MODEL=gpt-4o-mini


# ============================================================
# 方案 D3：OpenRouter（统一网关，可调200+模型）
# ============================================================
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
# DEFAULT_PROVIDER=openrouter
# DEFAULT_MODEL=anthropic/claude-sonnet-4
# BUDGET_MODEL=openai/gpt-4o-mini


# ============================================================
# 方案 E：本地 Ollama（免费，需 GPU）
# ============================================================
# 安装：https://ollama.com
# 拉取模型：ollama pull qwen3:32b
# OLLAMA_BASE_URL=http://localhost:11434
# DEFAULT_PROVIDER=ollama
# DEFAULT_MODEL=qwen3:32b
# BUDGET_MODEL=qwen3:8b


# ============================================================
# 按 Agent 精细调参（可选，覆盖上面的全局配置）
# ============================================================
# 格式：AGENT_TYPE_MODEL=provider:model
# 省略 provider 则使用 DEFAULT_PROVIDER 的值。
#
# 各 Agent 职责：
#   topic_scout         市场调研（扫榜分析、选题、书名生成）
#   architect           世界观构建
#   character_manager   角色创建
#   plot_planner        大纲规划
#   writer              章节写作（最消耗 token，建议用最好的模型）
#   editor              章节审阅
#   continuity_checker  设定一致性检查
#   reader_simulator    读者视角模拟
#   refiner             润色修改
#   reviewer            对抗性审稿（独立视角发现盲区）
#   memory_manager      伏笔/设定记忆管理
#   orchestrator        流程编排（轻量）
#
# 示例 — 高质量省钱方案（Writer 用 Claude，审稿用 DeepSeek）：
#   WRITER_MODEL=anthropic:claude-sonnet-4-20250514
#   REVIEWER_MODEL=anthropic:claude-sonnet-4-20250514
#   EDITOR_MODEL=deepseek-chat
#   CONTINUITY_CHECKER_MODEL=deepseek-chat

# TOPIC_SCOUT_MODEL=
# ARCHITECT_MODEL=
# CHARACTER_MANAGER_MODEL=
# PLOT_PLANNER_MODEL=
# WRITER_MODEL=
# EDITOR_MODEL=
# CONTINUITY_CHECKER_MODEL=
# READER_SIMULATOR_MODEL=
# REFINER_MODEL=
# REVIEWER_MODEL=
# MEMORY_MANAGER_MODEL=
# ORCHESTRATOR_MODEL=


# ============================================================
# 基础配置
# ============================================================
WORKSPACE_ROOT=./workspace
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DEFAULT_CHAPTER_WORD_COUNT=3000
MAX_REVIEW_ITERATIONS=3
MIN_REVIEW_SCORE_ACCEPT=6.5
MAX_CONTEXT_CHAPTERS=5
MAX_CONTEXT_FACTS=20
